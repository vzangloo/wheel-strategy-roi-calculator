{
  "manifest_version": 3,
  "name": "Wheel Strategy \u2014 IBKR ROI Calculator",
  "version": "5.1.4",
  "description": "IBKR Wheel Strategy: Sell Put/Call ROI calculator with IV tracking, Wishlist, and capital planning.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.interactivebrokers.com/*",
    "*://*.interactivebrokers.com.au/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Toggle Option Wheel Strategy ROI Calculator"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "icons/*.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}